{
    "name": "magic-office-editor",
    "productName": "Magic Office Editor",
    "version": "0.1.0",
    "description": "Editor de documentos para Windows com revisão por IA sob seu controle.",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.cjs",
    "author": "Ivan Ferrer",
    "repository": "https://github.com/ivanferrer/magic-office-editor",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "test:ui": "playwright test tests/editor.spec.ts",
        "test:desktop": "playwright test tests/desktop.spec.ts",
        "check": "npm run test && npm run build",
        "start": "electron .",
        "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
    },
    "dependencies": {
        "@tiptap/core": "3.31.4",
        "@tiptap/extension-highlight": "3.31.4",
        "@tiptap/extension-image": "3.31.4",
        "@tiptap/extension-placeholder": "3.31.4",
        "@tiptap/extension-table": "3.31.4",
        "@tiptap/extension-text-align": "3.31.4",
        "@tiptap/extension-text-style": "3.31.4",
        "@tiptap/pm": "3.31.4",
        "@tiptap/react": "3.31.4",
        "@tiptap/starter-kit": "3.31.4",
        "docx": "9.10.0",
        "dompurify": "^3.3.0",
        "image-size": "^2.0.4",
        "lucide-react": "^0.468.0",
        "mammoth": "^1.11.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sanitize-html": "^2.17.0",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/sanitize-html": "^2.16.0",
        "@vitejs/plugin-react": "^5.1.0",
        "electron": "44.7.0",
        "electron-builder": "26.15.3",
        "esbuild": "^0.27.0",
        "prettier": "^3.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.0",
        "vite": "^7.3.0"
    },
    "build": {
        "appId": "com.ivanferrer.magicoffice",
        "productName": "Magic Office Editor",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "asar": true,
        "win": {
            "target": [
                "nsis"
            ],
            "artifactName": "Magic-Office-Editor-${version}-Setup.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Magic Office Editor",
            "installerLanguages": [
                "pt_BR",
                "en_US"
            ]
        }
    }
}
